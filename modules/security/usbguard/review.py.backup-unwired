def prompt_dock_group_gtk(devices, title: str):
    Gtk, _, GLib = gtk_modules()
    if Gtk is None:
        return "deny", []

    result = {"decision": "deny", "selected_ids": []}
    group_ids = {str(device.get("id", "")) for device in devices if str(device.get("id", "")).strip()}
    dialog = Gtk.Dialog(title=title, flags=Gtk.DialogFlags.MODAL)
    dialog.set_default_size(980, 460)
    dialog.set_keep_above(True)
    dialog.set_border_width(12)
    dialog.set_modal(True)
    root = dialog.get_content_area()
    root.set_spacing(10)

    intro = Gtk.Label(
        label=tr("This dock or USB-C hub exposes multiple subdevices. Tick the ones you want to allow and leave the rest blocked.")
    )
    intro.set_line_wrap(True)
    intro.set_xalign(0.0)
    root.pack_start(intro, False, False, 0)

    columns = [
        tr("Allow"),
        "id",
        tr("Name"),
        tr("Type"),
        tr("Port"),
        tr("Risk"),
        tr("Claims"),
    ]
    store = Gtk.ListStore(bool, str, str, str, str, str, str)
    for device in devices:
        lsusb_line, verbose = lsusb_text(device)
        assessment = assess_device(device, verbose, lsusb_line)
        pretty_name = device_display_name(device, lsusb_line, verbose)
        interfaces = ", ".join(decode_interfaces(device.get("interfaces", []))[:2]) or tr("<none>")
        store.append(
            [
                True,
                str(device.get("id", "")),
                pretty_name or device.get("usb_id") or tr("Unknown USB device"),
                device.get("usb_id", "<unknown>"),
                via_port(device) or "<unknown>",
                assessment["risk"],
                interfaces,
            ]
        )

    tree = Gtk.TreeView(model=store)
    tree.set_headers_visible(True)

    toggle = Gtk.CellRendererToggle()

    def on_toggle(_renderer, path):
        store[path][0] = not store[path][0]

    toggle.connect("toggled", on_toggle)
    tree.append_column(Gtk.TreeViewColumn(columns[0], toggle, active=0))

    for index, label in enumerate(columns[2:], start=2):
        renderer = Gtk.CellRendererText()
        renderer.set_property("ellipsize", Pango.EllipsizeMode.END)
        column = Gtk.TreeViewColumn(label, renderer, text=index)
        column.set_resizable(True)
        tree.append_column(column)

    scroller = Gtk.ScrolledWindow()
    scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
    scroller.set_hexpand(True)
    scroller.set_vexpand(True)
    scroller.add(tree)
    root.pack_start(scroller, True, True, 0)

    buttons = Gtk.ButtonBox(orientation=Gtk.Orientation.HORIZONTAL)
    buttons.set_layout(Gtk.ButtonBoxStyle.END)
    buttons.set_spacing(8)
    root.pack_start(buttons, False, False, 0)

    def current_selection():
        return [row[1] for row in store if row[0]]

    def finish(decision: str):
        result["decision"] = decision
        result["selected_ids"] = current_selection()
        dialog.response(Gtk.ResponseType.NONE)

    once_button = Gtk.Button(label=tr("Approve selected once"))

    def on_once(*_args):
        if not current_selection():
            show_selection_required_gtk(dialog)
            return
        finish("approve-once")

    once_button.connect("clicked", on_once)
    buttons.add(once_button)

    permanent_button = Gtk.Button(label=tr("Approve selected permanently"))

    def on_group_permanent(*_args):
        selected = current_selection()
        if not selected:
            show_selection_required_gtk(dialog)
            return
        if confirm_permanent_gtk(dialog, tr(f"{len(selected)} selected dock device(s)")):
            finish("approve-permanently")

    permanent_button.connect("clicked", on_group_permanent)
    buttons.add(permanent_button)

    deny_button = Gtk.Button(label=tr("Keep all blocked"))
    deny_button.connect("clicked", lambda *_: finish("deny"))
    buttons.add(deny_button)

    def auto_close_if_group_gone():
        if result["decision"] != "deny":
            return False
        blocked = blocked_id_set()
        any_present = any(is_device_still_present(device) for device in devices)
        if (group_ids and not (group_ids & blocked)) or (not any_present):
            finish("deny")
            return False
        return True

    if GLib is not None:
        GLib.timeout_add_seconds(1, auto_close_if_group_gone)

    dialog.connect("delete-event", lambda *_args: finish("deny") or False)
    dialog.show_all()
    dialog.run()
    dialog.destroy()
    return result["decision"], result["selected_ids"]


def prompt(device, summary: str, title: str, banner: str) -> str:
    popups = os.environ.get("USBGUARD_REVIEW_POPUPS", "0") == "1"
    display = os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
    lsusb_line, verbose = lsusb_text(device)
    pretty_name = device_display_name(device, lsusb_line, verbose)
    assessment = assess_device(device, verbose, lsusb_line)
    if can_use_gtk(popups, display):
        return prompt_gtk(device, summary, title, banner)

    print(summary)
    print()
    response = input(f"{tr('Approve this device?')} [o]{tr('nce')} / [p]{tr('ermanent')} / [N]{tr('o')} ").strip().lower()
    if response in {"o", "once", "y", "yes"}:
        return "approve-once"
    if response in {"p", "permanent"}:
        if confirm_permanent(title, pretty_name or "Unknown USB device", assessment["risk"]):
            return "approve-permanently"
    return "deny"


def prompt_dock_group(devices, title: str):
    popups = os.environ.get("USBGUARD_REVIEW_POPUPS", "0") == "1"
    display = os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
    if can_use_gtk(popups, display):
        return prompt_dock_group_gtk(devices, title)

    print(tr("Dock group review:"))
    for device in devices:
        print(f"  [{device.get('id')}] {device.get('name') or device.get('usb_id')} @ {via_port(device)}")
    print()
    response = input(tr("Enter USBGuard IDs to approve, separated by spaces, or press Enter to keep all blocked: ")).strip()
    if not response:
        return "deny", []
    selected_ids = response.split()
    mode = input(tr("Approve selected [o]nce / [p]ermanent / [N]o ")).strip().lower()
    if mode in {"o", "once", "y", "yes"}:
        return "approve-once", selected_ids
    if mode in {"p", "permanent"} and confirm_group_permanent(title, len(selected_ids)):
        return "approve-permanently", selected_ids
    return "deny", []


def notify(message: str):
    display = os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
    if display:
        subprocess.run(["notify-send", "USBGuard", message], check=False)


def blocked_devices():
    lines = run("usbguard", "list-devices", "-b", check=False).splitlines()
    devices = []
    for line in lines:
        parsed = parse_rule_line(line)
        if parsed:
            devices.append(parsed)
            if len(devices) >= MAX_BLOCKED_SCAN:
                break
    return devices


def load_whitelist():
    path = os.environ.get("USBGUARD_WHITELIST_JSON")
    if not path:
        return {}
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        return {}


def watch():
    state_dir = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "usbguard-review"
    state_dir.mkdir(parents=True, exist_ok=True)
    seen_dir = state_dir / "seen"
    seen_dir.mkdir(exist_ok=True)

    whitelist = load_whitelist()
    trusted_rules = {item.get("rule"): item for item in whitelist.get("devices", [])}
    last_prompt_by_port = {}
    last_prompt_global_at = 0.0
    serial_queue_mode = env_flag("USBGUARD_SERIAL_QUEUE_MODE", "1")
    disable_dock_grouping = env_flag("USBGUARD_DISABLE_DOCK_GROUPING", "1")
    auto_prompt = env_flag("USBGUARD_REVIEW_AUTO_PROMPT", "0")

    while True:
        devices = blocked_devices()
        devices.sort(key=lambda d: int(d.get("id", "0")) if str(d.get("id", "")).isdigit() else 0)
        active_keys = set()
        grouped_keys = set()
        now = time.monotonic()
        prompts_this_cycle = 0
        queued_names = []

        for device in devices:
            if prompts_this_cycle >= MAX_PROMPTS_PER_CYCLE:
                break
            key = device_key(device)
            active_keys.add(key)
            if key in grouped_keys:
                continue
            marker = seen_dir / key
            if marker.exists():
                continue

            port_token = root_port_token(device)
            if port_token:
                last_prompt_port_at = last_prompt_by_port.get(port_token, 0.0)
                if now - last_prompt_port_at < PORT_PROMPT_COOLDOWN_SECONDS:
                    continue

            if now - last_prompt_global_at < PROMPT_COOLDOWN_SECONDS:
                continue

            group = [device] if disable_dock_grouping else dock_group(devices, device)
            if (not serial_queue_mode) and len(group) > 1:
                if port_token:
                    last_prompt_by_port[port_token] = now
                last_prompt_global_at = now
                prompts_this_cycle += 1
                group_title = tr("USBGuard review: Dock / USB-C device group")
                if not auto_prompt:
                    for group_device in group:
                        group_key = device_key(group_device)
                        grouped_keys.add(group_key)
                        group_marker = seen_dir / group_key
                        group_title_name = group_device.get("name") or group_device.get("usb_id") or "Unknown USB device"
                        if not group_marker.exists():
                            group_marker.write_text("queued", encoding="utf-8")
                            queued_names.append(group_title_name)
                    continue

                decision, selected_ids = prompt_dock_group(group, group_title)
                selected_ids = set(selected_ids)

                for group_device in group:
                    group_key = device_key(group_device)
                    grouped_keys.add(group_key)
                    group_marker = seen_dir / group_key
                    group_title_name = group_device.get("name") or group_device.get("usb_id") or "Unknown USB device"
                    if str(group_device.get("id", "")) in selected_ids:
                        group_marker.write_text(decision, encoding="utf-8")
                        if decision == "approve-once":
                            approve(group_device, permanent=False)
                            notify(f"Approved once: {group_title_name}")
                        elif decision == "approve-permanently":
                            approve(group_device, permanent=True)
                            notify(f"Approved permanently: {group_title_name}")
                    else:
                        group_marker.write_text("deny", encoding="utf-8")
                continue

            if port_token:
                last_prompt_by_port[port_token] = now
            last_prompt_global_at = now
            prompts_this_cycle += 1
            title_name = device.get("name") or device.get("usb_id") or "Unknown USB device"

            if not auto_prompt:
                marker.write_text("queued", encoding="utf-8")
                queued_names.append(title_name)
                continue

            summary = render_summary(device)
            _trusted, note = repo_note(device, trusted_rules)
            summary += note
            decision = prompt(device, summary, f"USBGuard review: {title_name}", banner_markup(device))
            marker.write_text(decision, encoding="utf-8")

            if decision == "approve-once":
                approve(device, permanent=False)
                notify(f"Approved once: {title_name}")
            elif decision == "approve-permanently":
                approve(device, permanent=True)
                notify(f"Approved permanently: {title_name}")
            else:
                notify(f"Kept blocked: {title_name}")

            # Strictly process queue one-by-one in serial mode to avoid bursts.
            if serial_queue_mode:
                break

        if queued_names:
            if len(queued_names) == 1:
                queued_detail = queued_names[0]
            elif len(queued_names) == 2:
                queued_detail = f"{queued_names[0]}, {queued_names[1]}"
            else:
                queued_detail = f"{queued_names[0]}, {queued_names[1]}, +{len(queued_names) - 2} more"
            notify(f"USBGuard queued {len(queued_names)} device(s): {queued_detail} (run usbguard-review-queue)")

        for marker in seen_dir.iterdir():
            if marker.name not in active_keys:
                marker.unlink()

        stale_before = now - (PORT_PROMPT_COOLDOWN_SECONDS * 4)
        for token, ts in list(last_prompt_by_port.items()):
            if ts < stale_before:
                del last_prompt_by_port[token]

        sleep_seconds = QUEUE_POLL_SECONDS
        if len(devices) >= QUEUE_DORMANT_BACKLOG:
            sleep_seconds = max(sleep_seconds, QUEUE_DORMANT_SLEEP_SECONDS)
        time.sleep(sleep_seconds)


def main():
    if "--watch" in sys.argv:
        watch()
        return

    devices = blocked_devices()
    if not devices:
        print("No blocked USB devices in queue.")
        return

    whitelist = load_whitelist()
    trusted_rules = {item.get("rule"): item for item in whitelist.get("devices", [])}
    handled = set()

    for device in devices:
        key = device_key(device)
        if key in handled:
            continue

        group = dock_group(devices, device)
        if len(group) > 1:
            decision, selected_ids = prompt_dock_group(group, tr("USBGuard review: Dock / USB-C device group"))
            selected_ids = set(selected_ids)
            for group_device in group:
                handled.add(device_key(group_device))
                title_name = group_device.get("name") or group_device.get("usb_id") or "Unknown USB device"
                if str(group_device.get("id", "")) in selected_ids:
                    approve(group_device, permanent=(decision == "approve-permanently"))
                    if decision == "approve-permanently":
                        print(f"Approved permanently: {title_name}")
                    elif decision == "approve-once":
                        print(f"Approved once: {title_name}")
                else:
                    print(f"Left blocked {title_name}")
            continue

        summary = render_summary(device)
        _, note = repo_note(device, trusted_rules)
        summary += note
        title_name = device.get("name") or device.get("usb_id") or "Unknown USB device"
        decision = prompt(device, summary, f"USBGuard review: {title_name}", banner_markup(device))
        handled.add(key)
        if decision == "approve-once":
            approve(device, permanent=False)
            print(f"Approved once: {title_name}")
        elif decision == "approve-permanently":
            approve(device, permanent=True)
            print(f"Approved permanently: {title_name}")
        else:
            print(f"Left blocked {title_name}")


if __name__ == "__main__":
    main()
